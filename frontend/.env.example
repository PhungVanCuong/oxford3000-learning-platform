# ---> [CẤU HÌNH 1: Chạy test trên máy Localhost (Backend chạy 'php artisan serve' cổng 8000)]:
VITE_API_BASE_URL=http://localhost:8000

# ---> [CẤU HÌNH 2: Chạy test trên máy Localhost (Backend chạy qua XAMPP / Laragon / Nginx cổng 80 chuẩn)]:
# VITE_API_BASE_URL=http://localhost

# ---> [CẤU HÌNH 3: Chạy trên Web Hosting / Production domain chính thức]:
# VITE_API_BASE_URL=https://beoxvocab.deloydz.io.vn

# Google OAuth Client ID (cho popup/One-Tap trên frontend nếu cần)
VITE_GOOGLE_CLIENT_ID=

